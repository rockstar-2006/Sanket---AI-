# ==============================================================================
# Sanket AI - Environment Configuration Template
# COPY this file to .env.local for local development.
# In Production (Vercel, Railway, Render, VPS), set these in your dashboard.
# NEVER commit .env or .env.local to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Authentication & Firestore (Optional / For user accounts & dashboard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. WebRTC Video Consultation & Real-time Room Signaling
# ------------------------------------------------------------------------------
# For local dev: http://localhost:3000 (handled automatically by node server/index.js)
# For production deployment: set to your public domain (e.g. https://your-domain.com)
NEXT_PUBLIC_SIGNALING_SERVER_URL=http://localhost:3000

# LiveKit Media Server Configuration (Optional for dedicated mesh audio/video)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud

# ------------------------------------------------------------------------------
# 3. AI Providers for Contextual ISL Sentence Formation
# (Users can also enter their own keys directly in the web UI modal)
# ------------------------------------------------------------------------------
# Google Gemini (Default)
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude (Claude 3.7 Sonnet, Claude 3.5 Sonnet, Haiku, Opus)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY=your_openai_api_key

# Groq (Ultra-low latency Llama 3.3 70B, Llama 3.1 8B)
GROQ_API_KEY=your_groq_api_key

# OpenRouter (Multi-model gateway)
OPENROUTER_API_KEY=your_openrouter_api_key

# ------------------------------------------------------------------------------
# 4. Speech Engines (ASR & TTS)
# ------------------------------------------------------------------------------
# Deepgram Real-time ASR (Speech-to-Text for customer phone voice)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs Neural Voice Synthesis (Optional; built-in Web Speech fallback is active by default)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# ------------------------------------------------------------------------------
# 5. Exotel Cloud Telephony & BPO Helpline Trunk (Optional)
# ------------------------------------------------------------------------------
EXOTEL_ACCOUNT_SID=your_exotel_subdomain_or_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PHONE_NUMBER=your_virtual_exophone_number
EXOTEL_VIRTUAL_MOBILE=your_forwarding_bridge_number
